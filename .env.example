# ============================================
# FoodChain AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---------- PostgreSQL ----------
POSTGRES_USER=foodchain
POSTGRES_PASSWORD=foodchain_secret_2024
POSTGRES_DB=foodchain_db
# Change:
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://foodchain:foodchain_secret_2024@localhost:5432/foodchain_db

POSTGRES_PORT=5432
#DATABASE_URL=postgresql://foodchain:foodchain_secret_2024@db:5432/foodchain_db

# ---------- Backend (FastAPI) ----------
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
